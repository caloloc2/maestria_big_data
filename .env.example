# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno — COPIAR a `.env` y rellenar.
# `.env` está gitignored (nunca se sube). Aquí NO pongas secretos reales.
# ─────────────────────────────────────────────────────────────

# --- MySQL CDR de Asterisk (SOLO LECTURA) ---
CDR_HOST=192.168.0.XX          # IP interna del servidor Asterisk/MySQL
CDR_PORT=3306
CDR_DB=asteriskcdrdb           # nombre real de la base (confirmar)
CDR_TABLE=cdr                  # tabla de CDR (confirmar)
CDR_USER=readonly              # usuario de solo lectura (recomendado crear uno)
CDR_PASSWORD=CAMBIAME
CDR_CHARSET=latin1             # el CDR viene en latin1 -> se normaliza a UTF-8

# --- Servidor Asterisk (SSH, para construir el índice de audio) ---
AST_SSH_HOST=192.168.0.XX      # IP interna del servidor de grabaciones
AST_SSH_USER=root
AUDIO_ROOT=/home/grabacion/monitor/111111111111

# --- Rutas locales (dentro del contenedor de diagnóstico) ---
AUDIO_INDEX=/work/data/diag/audio_index.tsv.gz
OUT_DIR=/work/data/diag
