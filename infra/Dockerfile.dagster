# Imagen del orquestador Dagster (webserver + daemon) + procesamiento batch (Spark).
# Base bookworm (Debian 12): trae openjdk-17, la versión de Java que soporta PySpark 3.5.
FROM python:3.11-slim-bookworm

ENV DAGSTER_HOME=/opt/dagster/dagster_home \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/dagster/app \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    PATH=/usr/lib/jvm/java-17-openjdk-amd64/bin:$PATH

# Java 17 (requerido por PySpark) + procps para diagnósticos
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p $DAGSTER_HOME /opt/dagster/app

COPY infra/requirements.dagster.txt /tmp/req.txt
RUN pip install --no-cache-dir -r /tmp/req.txt

# JARs de conectividad S3A (Hadoop AWS) para que Spark lea/escriba en MinIO (s3a://).
# Versiones atadas a PySpark 3.5.3 (cliente Hadoop 3.3.4). Se hornean en la imagen para
# no depender de internet en runtime (despliegue on-premise reproducible).
ARG HADOOP_AWS=3.3.4
ARG AWS_SDK_BUNDLE=1.12.262
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && SPARK_JARS="$(python -c 'import pyspark, os; print(os.path.join(os.path.dirname(pyspark.__file__), "jars"))')" \
    && curl -fsSL -o "$SPARK_JARS/hadoop-aws-${HADOOP_AWS}.jar" \
        "https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/${HADOOP_AWS}/hadoop-aws-${HADOOP_AWS}.jar" \
    && curl -fsSL -o "$SPARK_JARS/aws-java-sdk-bundle-${AWS_SDK_BUNDLE}.jar" \
        "https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/${AWS_SDK_BUNDLE}/aws-java-sdk-bundle-${AWS_SDK_BUNDLE}.jar" \
    && rm -rf /var/lib/apt/lists/*

# Configuración de almacenamiento de metadatos (apunta a PostgreSQL)
COPY infra/dagster/dagster.yaml $DAGSTER_HOME/dagster.yaml

WORKDIR /opt/dagster/app
# El código (src/), el workspace.yaml, el .env y data/ se montan como volúmenes en dev.
